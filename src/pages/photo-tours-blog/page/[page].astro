---
export const prerender = true;

import BlogHubPage from '../../../components/blog/BlogHubPage.astro';
import { getBlogHubStaticPaths } from '../../../lib/blog-hub';

export async function getStaticPaths() {
  return getBlogHubStaticPaths('photo-tours-blog');
}

const page = Number(Astro.params.page);
---

<BlogHubPage
  page={page}
  categoryPrefix="photo-tours-blog"
  title="Photo Tours Blog"
  eyebrow="Journal"
  description="Landscape and travel photography field notes from tours across Ireland."
/>
