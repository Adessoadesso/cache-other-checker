---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogSidebar from '../../components/blog/BlogSidebar.astro';
import { buildSearchIndex, categoryStats } from '../../lib/blog-hub';
import { allPublishedPosts } from '../../lib/blog';

const searchIndex = await buildSearchIndex();
const categories = categoryStats(await allPublishedPosts());
---

<BaseLayout
  title="Search — Panoramic Ireland"
  description="Search Panoramic Ireland blog articles by keyword."
>
  <section class="container search-hub">
    <header class="search-hub__header">
      <p class="eyebrow">Journal</p>
      <h1>Search</h1>
      <form class="search-form" action="/new-search-1-all" method="get" role="search">
        <label class="visually-hidden" for="search-q">Search keywords</label>
        <input id="search-q" type="search" name="q" placeholder="Search …" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
      <p id="search-summary" class="search-summary" hidden></p>
    </header>

    <div class="search-hub__layout">
      <div id="search-results" class="search-results" aria-live="polite"></div>
      <BlogSidebar categories={categories} />
    </div>
  </section>

  <script id="blog-search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <script is:inline>
    (function () {
      const indexEl = document.getElementById('blog-search-index');
      const resultsEl = document.getElementById('search-results');
      const summaryEl = document.getElementById('search-summary');
      const inputEl = document.getElementById('search-q');
      if (!indexEl || !resultsEl || !summaryEl || !inputEl) return;

      const index = JSON.parse(indexEl.textContent || '[]');
      const params = new URLSearchParams(window.location.search);
      const query = (params.get('q') || '').trim();
      inputEl.value = query;

      function formatDate(iso) {
        return new Date(iso).toLocaleDateString('en-IE', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
      }

      function escapeHtml(value) {
        return value
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function score(entry, q) {
        const haystack = [
          entry.title,
          entry.excerpt,
          entry.kicker,
          entry.categoryTitle,
          ...(entry.tags || []),
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();
        const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
        let score = 0;
        for (const term of terms) {
          if (entry.title.toLowerCase().includes(term)) score += 4;
          if (haystack.includes(term)) score += 2;
        }
        return score;
      }

      function renderResults(q) {
        if (!q) {
          summaryEl.hidden = true;
          resultsEl.innerHTML =
            '<p class="search-empty">Enter a keyword above, or pick one from the sidebar.</p>';
          return;
        }

        const matches = index
          .map((entry) => ({ entry, score: score(entry, q) }))
          .filter((item) => item.score > 0)
          .sort((a, b) => b.score - a.score || new Date(b.entry.pubDate) - new Date(a.entry.pubDate));

        summaryEl.hidden = false;
        summaryEl.textContent =
          matches.length === 0
            ? `No results for “${q}”.`
            : `${matches.length} result${matches.length === 1 ? '' : 's'} for “${q}”.`;

        if (matches.length === 0) {
          resultsEl.innerHTML = '<p class="search-empty">Try a broader keyword such as “dublin” or “sunset”.</p>';
          return;
        }

        resultsEl.innerHTML = matches
          .map(({ entry }) => {
            const image = entry.heroImage
              ? `<a class="search-card__media" href="${entry.url}" tabindex="-1" aria-hidden="true"><img src="${escapeHtml(entry.heroImage)}" alt="${escapeHtml(entry.heroImageAlt || entry.title)}" loading="lazy" /></a>`
              : '<span class="search-card__placeholder" aria-hidden="true"></span>';
            const category = entry.categoryHref
              ? `<a class="search-card__category" href="${entry.categoryHref}">${escapeHtml(entry.categoryTitle || 'Journal')}</a>`
              : '';
            return `<article class="search-card">${image}<div class="search-card__body"><h2 class="search-card__title"><a href="${entry.url}">${escapeHtml(entry.title)}</a></h2><div class="search-card__meta"><time datetime="${entry.pubDate}">${formatDate(entry.pubDate)}</time>${category ? `<span class="search-card__sep">·</span>${category}` : ''}<span class="search-card__sep">·</span><span>${escapeHtml(entry.author)}</span></div>${entry.kicker ? `<p class="search-card__kicker">${escapeHtml(entry.kicker)}</p>` : ''}<p class="search-card__excerpt">${escapeHtml(entry.excerpt)}</p><a class="search-card__more" href="${entry.url}">Read More</a></div></article>`;
          })
          .join('');
      }

      renderResults(query);
    })();
  </script>
</BaseLayout>

<style>
  .search-hub {
    padding-block: var(--space-xl) var(--space-l);
  }

  .search-hub__header {
    margin-bottom: var(--space-l);
    max-width: 40rem;
  }

  .search-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.65rem;
    margin-top: var(--space-m);
  }

  .search-form input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .search-summary {
    margin-top: var(--space-s);
    color: var(--color-ink-soft);
    font-family: var(--font-body);
    font-size: var(--step-small);
  }

  .search-hub__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
    gap: var(--space-l);
    align-items: start;
  }

  .search-results {
    display: grid;
    gap: var(--space-m);
  }

  .search-empty {
    color: var(--color-ink-soft);
  }

  :global(.search-card) {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: var(--space-m);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  :global(.search-card__media) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-paper-dim);
  }

  :global(.search-card__media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.search-card__placeholder) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 180px;
    background: var(--color-paper-dim);
  }

  :global(.search-card__title) {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    margin: 0 0 0.45rem;
  }

  :global(.search-card__title a) {
    color: var(--color-ink);
    text-decoration: none;
  }

  :global(.search-card__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--color-ink-soft);
    margin-bottom: 0.65rem;
  }

  :global(.search-card__category) {
    color: var(--color-forest-700);
    font-weight: 700;
    text-decoration: none;
  }

  :global(.search-card__kicker) {
    font-family: var(--font-display);
    color: var(--color-gold-600);
    margin: 0 0 0.35rem;
  }

  :global(.search-card__excerpt) {
    font-family: var(--font-serif-body);
    color: var(--color-ink-soft);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }

  :global(.search-card__more) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--step-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest-700);
    text-decoration: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .search-hub__layout {
      grid-template-columns: 1fr;
    }

    :global(.search-card) {
      grid-template-columns: 1fr;
    }
  }
</style>
