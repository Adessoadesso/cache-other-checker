---
import { render } from 'astro:content';
import SmartImage from '../SmartImage.astro';
import {
  formatBlogDate,
  postCategoryLink,
  postDisplayDate,
  postExcerpt,
  type BlogSearchEntry,
} from '../../lib/blog-hub';
import { postUrl, type BlogPost } from '../../lib/blog';

interface Props {
  post?: BlogPost;
  entry?: BlogSearchEntry;
  variant?: 'card' | 'expanded';
}

const { post, entry, variant = 'card' } = Astro.props;
const rendered = variant === 'expanded' && post ? await render(post) : null;
const Content = rendered?.Content;

const data = post
  ? {
      title: post.data.title,
      url: postUrl(post),
      kicker: post.data.kicker,
      excerpt: postExcerpt(post),
      heroImage: post.data.heroImage,
      heroImageAlt: post.data.heroImageAlt,
      pubDate: postDisplayDate(post),
      author: post.data.author,
      category: postCategoryLink(post),
    }
  : entry
    ? {
        title: entry.title,
        url: entry.url,
        kicker: entry.kicker,
        excerpt: entry.excerpt,
        heroImage: entry.heroImage,
        heroImageAlt: entry.heroImageAlt,
        pubDate: new Date(entry.pubDate),
        author: entry.author,
        category: entry.categoryHref
          ? { title: entry.categoryTitle ?? 'Journal', href: entry.categoryHref }
          : null,
      }
    : null;

if (!data) {
  throw new Error('BlogArticleCard requires post or entry');
}
---

{variant === 'expanded' && post && Content ? (
  <article class="blog-card blog-card--expanded">
    <header class="blog-card__body blog-card__body--expanded">
      <h2 class="blog-card__title">
        <a href={data.url}>{data.title}</a>
      </h2>

      <div class="blog-card__meta">
        <time datetime={data.pubDate.toISOString()}>{formatBlogDate(data.pubDate)}</time>
        {data.category && (
          <>
            <span class="blog-card__sep" aria-hidden="true">/</span>
            <a class="blog-card__category" href={data.category.href}>{data.category.title}</a>
          </>
        )}
        <span class="blog-card__sep" aria-hidden="true">/</span>
        <span>{data.author}</span>
      </div>

      {data.kicker && <p class="blog-card__kicker">{data.kicker}</p>}
      {post.data.standfirst && <p class="blog-card__standfirst">{post.data.standfirst}</p>}
    </header>

    {data.heroImage && (
      <a class="blog-card__media blog-card__media--expanded" href={data.url} tabindex="-1" aria-hidden="true">
        <SmartImage src={data.heroImage} alt={data.heroImageAlt ?? data.title} />
      </a>
    )}

    <div class="blog-card__prose">
      <Content />
    </div>

    <a class="blog-card__more" href={data.url}>Read More</a>
  </article>
) : (
  <article class="blog-card">
    <a class="blog-card__media" href={data.url} tabindex="-1" aria-hidden="true">
      {data.heroImage ? (
        <SmartImage src={data.heroImage} alt={data.heroImageAlt ?? data.title} />
      ) : (
        <span class="blog-card__placeholder" aria-hidden="true" />
      )}
    </a>

    <div class="blog-card__body">
      <h2 class="blog-card__title">
        <a href={data.url}>{data.title}</a>
      </h2>

      <div class="blog-card__meta">
        <time datetime={data.pubDate.toISOString()}>{formatBlogDate(data.pubDate)}</time>
        {data.category && (
          <>
            <span class="blog-card__sep" aria-hidden="true">/</span>
            <a class="blog-card__category" href={data.category.href}>{data.category.title}</a>
          </>
        )}
        <span class="blog-card__sep" aria-hidden="true">/</span>
        <span>{data.author}</span>
      </div>

      {data.kicker && <p class="blog-card__kicker">{data.kicker}</p>}
      <p class="blog-card__excerpt">{data.excerpt}</p>
      <a class="blog-card__more" href={data.url}>Read More</a>
    </div>
  </article>
)}

<style>
  .blog-card {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: var(--space-m);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--color-line);
  }

  .blog-card__media {
    display: block;
    text-decoration: none;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-paper-dim);
  }

  .blog-card__media :global(.smart-img),
  .blog-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-paper-dim), var(--color-paper));
  }

  .blog-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.15;
    margin: 0 0 0.45rem;
  }

  .blog-card__title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .blog-card__title a:hover {
    color: var(--color-forest-700);
  }

  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--color-ink-soft);
    margin-bottom: 0.65rem;
  }

  .blog-card__category {
    color: var(--color-forest-700);
    font-weight: 700;
    text-decoration: none;
  }

  .blog-card__category:hover {
    color: var(--color-gold-600);
  }

  .blog-card__sep {
    opacity: 0.45;
  }

  .blog-card__kicker {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-gold-600);
    margin: 0 0 0.35rem;
  }

  .blog-card__excerpt {
    font-family: var(--font-serif-body);
    color: var(--color-ink-soft);
    line-height: 1.65;
    margin: 0 0 0.75rem;
  }

  .blog-card__more {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--step-small);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest-700);
    text-decoration: none;
  }

  .blog-card__more:hover {
    color: var(--color-gold-600);
  }

  .blog-card--expanded {
    display: block;
    max-width: 56rem;
    margin-inline: auto;
    padding-bottom: var(--space-l);
  }

  .blog-card__body--expanded {
    margin-bottom: var(--space-s);
  }

  .blog-card__media--expanded {
    width: min(100%, 42rem);
    margin: 0 auto var(--space-m);
    aspect-ratio: 3 / 2;
  }

  .blog-card--expanded .blog-card__title {
    font-size: var(--step-1);
    text-align: center;
  }

  .blog-card--expanded .blog-card__meta {
    justify-content: center;
  }

  .blog-card__standfirst {
    max-width: 48rem;
    margin-inline: auto;
    color: var(--color-ink-soft);
    text-align: center;
  }

  .blog-card__prose {
    font-family: var(--font-serif-body);
    font-size: 1rem;
    line-height: 1.72;
  }

  .blog-card__prose :global(p) {
    max-width: none;
  }

  .blog-card__prose :global(img) {
    display: block;
    max-width: min(100%, 42rem);
    height: auto;
    margin: var(--space-m) auto;
    border-radius: var(--radius);
  }

  .blog-card__prose :global(h2),
  .blog-card__prose :global(h3) {
    margin-top: var(--space-m);
  }

  @media (max-width: 780px) {
    .blog-card {
      grid-template-columns: 1fr;
    }

    .blog-card__media {
      max-height: 240px;
    }
  }
</style>