---
import { FEATURED_BLOG_KEYWORDS, type CategoryStat } from '../../lib/blog-hub';

interface Props {
  categories: CategoryStat[];
  searchAction?: string;
}

const { categories, searchAction = '/new-search-1-all' } = Astro.props;
---

<aside class="blog-sidebar" aria-label="Blog navigation">
  <section class="sidebar-block">
    <h2>Search</h2>
    <form class="search-form" action={searchAction} method="get" role="search">
      <label class="visually-hidden" for="blog-search">Search the blog</label>
      <input id="blog-search" type="search" name="q" placeholder="Search …" autocomplete="off" />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
  </section>

  <section class="sidebar-block">
    <h2>Keywords</h2>
    <ul class="keyword-list">
      {FEATURED_BLOG_KEYWORDS.map((keyword) => (
        <li>
          <a href={`${searchAction}?q=${encodeURIComponent(keyword)}`}>{keyword}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="sidebar-block">
    <h2>Blog Categories</h2>
    <ul class="category-list">
      {categories.map((cat) => (
        <li>
          <a href={cat.href}>
            {cat.title}
            <span class="count"> ({cat.count})</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</aside>

<style>
  .blog-sidebar {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .sidebar-block h2 {
    font-family: var(--font-body);
    font-size: var(--step-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-forest-700);
    margin: 0 0 var(--space-s);
  }

  .search-form {
    display: grid;
    gap: 0.65rem;
  }

  .search-form input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .keyword-list,
  .category-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
  }

  .category-list {
    flex-direction: column;
    flex-wrap: nowrap;
    gap: 0.55rem;
  }

  .keyword-list a,
  .category-list a {
    font-family: var(--font-body);
    font-size: var(--step-small);
    color: var(--color-forest-700);
    text-decoration: none;
  }

  .keyword-list a:hover,
  .category-list a:hover {
    color: var(--color-gold-600);
    text-decoration: underline;
  }

  .count {
    color: var(--color-ink-soft);
    font-weight: 400;
    margin-left: 0.2em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
