# Copy to .env for local dev / static builds. Site key is public (safe in HTML).
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_BOOKING_API_URL=https://api.panoramicireland.com

# Worker only — never put the Turnstile secret here; use:
# npx wrangler secret put TURNSTILE_SECRET_KEY

# Bunny Storage sync (scripts/sync-media-to-bunny.mjs) — never commit real password.
# BUNNY_STORAGE_ZONE=panoramicireland-images-media
# BUNNY_STORAGE_PASSWORD=
# BUNNY_STORAGE_HOST=storage.bunnycdn.com
# BUNNY_CDN_ORIGIN=https://panoramic-visuals.b-cdn.net
# Pull Zone Advanced token key (same as Bunny Security → Token Authentication).
# Also: npx wrangler secret put BUNNY_TOKEN_AUTH_KEY
# BUNNY_TOKEN_AUTH_KEY=
# Worker delivery uses wrangler.toml [vars] BUNNY_CDN_ORIGIN + MEDIA_BACKEND (not Storage password).
