# Copy to .env.migration and fill in real values, then run:
#   set -a; source .env.migration; set +a
#   node scripts/migrate-joomla-blog.mjs --category=12,15 --dry-run
#
# Use a read-only DB user pointed at the restored/clean Joomla database —
# never the production credentials, and never commit this file.

JOOMLA_DB_HOST=127.0.0.1
JOOMLA_DB_PORT=3306
JOOMLA_DB_USER=readonly_migration_user
JOOMLA_DB_PASSWORD=
JOOMLA_DB_NAME=panoramicireland_joomla
JOOMLA_TABLE_PREFIX=jos_
JOOMLA_SITE_ORIGIN=https://panoramicireland.com
